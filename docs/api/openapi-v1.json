{
  "components": {
    "schemas": {
      "ArtifactMetadata": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "created_at_ns": {
            "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Created At Ns",
            "type": "string"
          },
          "data_role": {
            "enum": [
              "SYNTHETIC",
              "DEVELOPMENT",
              "RESERVED_TEST",
              "NONE"
            ],
            "title": "Data Role",
            "type": "string"
          },
          "kind": {
            "enum": [
              "strategy_config",
              "tape_cache",
              "run_summary",
              "fills_csv",
              "orders_csv",
              "run_manifest"
            ],
            "title": "Kind",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": true,
            "title": "Provenance",
            "type": "object"
          },
          "run_id": {
            "anyOf": [
              {
                "pattern": "^run_[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "schema_type": {
            "description": "Schema identifier of the content, e.g. financeai.run_summary/1",
            "title": "Schema Type",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "media_type",
          "schema_type",
          "sha256",
          "size_bytes",
          "data_role",
          "run_id",
          "created_at_ns",
          "provenance"
        ],
        "title": "ArtifactMetadata",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Failure",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Api Version",
            "type": "string"
          },
          "readiness": {
            "description": "Worker admission readiness (not economic validity)",
            "enum": [
              "READY",
              "NOT_READY"
            ],
            "title": "Readiness",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "readiness"
        ],
        "title": "Health",
        "type": "object"
      },
      "Progress": {
        "additionalProperties": false,
        "properties": {
          "completed_steps": {
            "title": "Completed Steps",
            "type": "integer"
          },
          "phase": {
            "title": "Phase",
            "type": "string"
          },
          "total_steps": {
            "title": "Total Steps",
            "type": "integer"
          }
        },
        "required": [
          "phase",
          "completed_steps",
          "total_steps"
        ],
        "title": "Progress",
        "type": "object"
      },
      "RunAccepted": {
        "additionalProperties": false,
        "properties": {
          "cancel_url": {
            "title": "Cancel Url",
            "type": "string"
          },
          "replayed": {
            "description": "True when the idempotency key matched an existing identical request",
            "title": "Replayed",
            "type": "boolean"
          },
          "run_id": {
            "pattern": "^run_[0-9a-f]{32}$",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "INTERRUPTED"
            ],
            "title": "Status",
            "type": "string"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "status_url",
          "cancel_url",
          "replayed"
        ],
        "title": "RunAccepted",
        "type": "object"
      },
      "RunRequest": {
        "additionalProperties": false,
        "examples": [
          {
            "campaign_id": "demo",
            "job": {
              "kind": "synthetic_replay",
              "rows_per_venue": 300,
              "scenario": "base",
              "seed": 7,
              "start_ns": "1700000000000000000",
              "strategy": {
                "instruments": [
                  "venue_a/ALPHA-USD",
                  "venue_b/ALPHA-PERP"
                ],
                "name": "demo",
                "policy": {
                  "allow_short": true,
                  "cooldown_ms": 0,
                  "direction": {
                    "venue_a/ALPHA-USD": 1,
                    "venue_b/ALPHA-PERP": 0
                  },
                  "enter": 0.5,
                  "entry_slip_ticks": 1,
                  "exit": -1000000000.0,
                  "exit_slip_ticks": 20,
                  "max_hold_ms": 50,
                  "min_hold_ms": 0,
                  "size_units": {
                    "venue_a/ALPHA-USD": 1000,
                    "venue_b/ALPHA-PERP": 0
                  },
                  "stop_bps": 0.0
                },
                "schema": "financeai.strategy",
                "schema_version": "1.0",
                "session": {
                  "entry_stop_s": 0.4,
                  "exec_stop_s": 0.06,
                  "flatten_s": 0.3,
                  "warmup_s": 0
                },
                "signal": {
                  "depth_units": 1000,
                  "follower": "venue_a/ALPHA-USD",
                  "gate_ticks": 2,
                  "kind": "lead_gap",
                  "leader": "venue_b/ALPHA-PERP",
                  "window_ms": 20
                }
              },
              "venues": [
                "venue_a/ALPHA-USD",
                "venue_b/ALPHA-PERP"
              ]
            },
            "schema_version": "1.0"
          },
          {
            "campaign_id": "demo",
            "job": {
              "cache_artifact_ids": [
                "art_22222222222222222222222222222222",
                "art_33333333333333333333333333333333"
              ],
              "kind": "strategy_replay",
              "scenario": "higher_fees",
              "strategy_artifact_id": "art_11111111111111111111111111111111"
            },
            "schema_version": "1.0"
          }
        ],
        "properties": {
          "campaign_id": {
            "default": "default",
            "description": "Idempotency keys are unique per campaign",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Campaign Id",
            "type": "string"
          },
          "job": {
            "discriminator": {
              "mapping": {
                "strategy_replay": "#/components/schemas/StrategyReplayRequest",
                "synthetic_replay": "#/components/schemas/SyntheticReplayRequest"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/SyntheticReplayRequest"
              },
              {
                "$ref": "#/components/schemas/StrategyReplayRequest"
              }
            ],
            "title": "Job"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "job"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunResult": {
        "additionalProperties": false,
        "properties": {
          "account_valid": {
            "description": "Every venue ended flat and the position cap held",
            "title": "Account Valid",
            "type": "boolean"
          },
          "decisions": {
            "title": "Decisions",
            "type": "integer"
          },
          "fees": {
            "additionalProperties": {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            "description": "Taker fee per instrument as an exact decimal string",
            "title": "Fees",
            "type": "object"
          },
          "fees_per_unit": {
            "additionalProperties": {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            "title": "Fees Per Unit",
            "type": "object"
          },
          "fills": {
            "title": "Fills",
            "type": "integer"
          },
          "first_event_ns": {
            "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "First Event Ns",
            "type": "string"
          },
          "invalid_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invalid Reason"
          },
          "last_event_ns": {
            "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Last Event Ns",
            "type": "string"
          },
          "net_pnl": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Net result (binary64); null for an invalid account or multiple settlement currencies",
            "title": "Net Pnl"
          },
          "orders": {
            "title": "Orders",
            "type": "integer"
          },
          "pnl_by_currency": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pnl By Currency"
          },
          "round_trips": {
            "title": "Round Trips",
            "type": "integer"
          },
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "settlement_currencies": {
            "items": {
              "type": "string"
            },
            "title": "Settlement Currencies",
            "type": "array"
          }
        },
        "required": [
          "scenario",
          "account_valid",
          "invalid_reason",
          "net_pnl",
          "round_trips",
          "fills",
          "orders",
          "decisions",
          "first_event_ns",
          "last_event_ns",
          "fees"
        ],
        "title": "RunResult",
        "type": "object"
      },
      "RunStatus": {
        "additionalProperties": false,
        "properties": {
          "artifact_ids": {
            "items": {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            "title": "Artifact Ids",
            "type": "array"
          },
          "attempt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Id"
          },
          "campaign_id": {
            "title": "Campaign Id",
            "type": "string"
          },
          "cancel_url": {
            "title": "Cancel Url",
            "type": "string"
          },
          "created_at_ns": {
            "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Created At Ns",
            "type": "string"
          },
          "economic_status": {
            "description": "Account validity of a finished replay; never a claim of economic success",
            "enum": [
              "NOT_EVALUATED",
              "VALID_ACCOUNT",
              "INVALID_ACCOUNT",
              "INCOMPLETE"
            ],
            "title": "Economic Status",
            "type": "string"
          },
          "evidence_scope": {
            "items": {
              "enum": [
                "SYNTHETIC",
                "DEVELOPMENT",
                "FRESH_TEST",
                "NONE"
              ],
              "type": "string"
            },
            "title": "Evidence Scope",
            "type": "array"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Failure"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at_ns": {
            "anyOf": [
              {
                "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At Ns"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "job": {
            "description": "The normalized job that was admitted (defaults filled in)",
            "discriminator": {
              "mapping": {
                "strategy_replay": "#/components/schemas/StrategyReplayRequest",
                "synthetic_replay": "#/components/schemas/SyntheticReplayRequest"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/SyntheticReplayRequest"
              },
              {
                "$ref": "#/components/schemas/StrategyReplayRequest"
              }
            ],
            "title": "Job"
          },
          "kind": {
            "enum": [
              "synthetic_replay",
              "strategy_replay"
            ],
            "title": "Kind",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "pattern": "^run_[0-9a-f]{32}$",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "started_at_ns": {
            "anyOf": [
              {
                "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At Ns"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "INTERRUPTED"
            ],
            "title": "Status",
            "type": "string"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          },
          "updated_at_ns": {
            "description": "UTC epoch nanoseconds (int64) as a canonical decimal string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Updated At Ns",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "campaign_id",
          "kind",
          "status",
          "attempt_id",
          "generation",
          "job",
          "progress",
          "failure",
          "result",
          "artifact_ids",
          "evidence_scope",
          "economic_status",
          "created_at_ns",
          "updated_at_ns",
          "started_at_ns",
          "finished_at_ns",
          "status_url",
          "cancel_url"
        ],
        "title": "RunStatus",
        "type": "object"
      },
      "StrategyReplayRequest": {
        "additionalProperties": false,
        "description": "Replay a registered strategy artifact on registered tape-cache artifacts.",
        "properties": {
          "cache_artifact_ids": {
            "items": {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "title": "Cache Artifact Ids",
            "type": "array"
          },
          "kind": {
            "const": "strategy_replay",
            "title": "Kind",
            "type": "string"
          },
          "scenario": {
            "enum": [
              "base",
              "higher_fees",
              "longer_delay",
              "combined_stress"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "strategy_artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Strategy Artifact Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "strategy_artifact_id",
          "cache_artifact_ids",
          "scenario"
        ],
        "title": "StrategyReplayRequest",
        "type": "object"
      },
      "SyntheticReplayRequest": {
        "additionalProperties": false,
        "description": "Replay an inline strategy on a deterministic synthetic two-venue market.",
        "properties": {
          "kind": {
            "const": "synthetic_replay",
            "title": "Kind",
            "type": "string"
          },
          "rows_per_venue": {
            "default": 300,
            "maximum": 20000.0,
            "minimum": 2.0,
            "title": "Rows Per Venue",
            "type": "integer"
          },
          "scenario": {
            "enum": [
              "base",
              "higher_fees",
              "longer_delay",
              "combined_stress"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "seed": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "start_ns": {
            "default": "0",
            "description": "Clock offset of the generated market: UTC epoch nanoseconds as a canonical decimal string, at most 4611686018427387904 (2**62, 2116-02-20) so that the clocks a replay derives (latency, acknowledgement, cooldown) stay inside int64",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Start Ns",
            "type": "string"
          },
          "strategy": {
            "additionalProperties": true,
            "description": "A financeai.strategy document, checked strictly and canonicalized before StrategyConfig validates it: integer parameters (direction, size_units, size_units_cap, max_clips, *_ms including abs_cap_ms and early_check_ms, *_ticks, unit-suffixed signal parameters and the counts ticks and levels) are JSON integers (no float or bool spellings), binary64 parameters (enter, exit, stop_bps, early_markout_bps, session seconds, composite component scale) accept integers or floats and are stored as floats, allow_short, refresh_hold and reverse are booleans; nested signal objects (gate, fresh, components) and exit_signal follow the signal rules. The canonical form is what is hashed for idempotency, reported as the admitted job and run.",
            "title": "Strategy",
            "type": "object"
          },
          "venues": {
            "items": {
              "enum": [
                "demo/INDEX-FUT",
                "demo/SHARE-USD",
                "venue_a/ALPHA-USD",
                "venue_b/ALPHA-PERP"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Venues",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "seed",
          "venues",
          "scenario",
          "strategy"
        ],
        "title": "SyntheticReplayRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Local random bearer token (FINANCEAI_API_TOKEN or token file)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Local, single-user research job API (loopback, bearer token). Submits bounded replay jobs to worker processes and reports their durable state and artifacts.",
    "title": "FinanceAI local research API",
    "version": "1.0.0",
    "x-api-version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Host header not allowed"
          }
        },
        "summary": "Process liveness and worker readiness (unauthenticated)",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "operationId": "get_artifact_v1_artifacts__artifact_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactMetadata"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Host header not allowed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unknown, malformed or inaccessible ID"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request or configuration"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
